# Express application database; configure the actual value outside source control.
DATABASE_URL=

# Required by the private Python FastAPI services; keep the actual value secret.
PYTHON_BACKEND_TOKEN=

# Optional Gemini configuration for AI advice.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional absolute path to a separate writable SQLite database.
# The tracked src/business_supplier_selection.db snapshot is read-only.
PYTHON_SQLITE_PATH=
